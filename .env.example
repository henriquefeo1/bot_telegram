# === Telegram ===
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# ID do canal privado (comece com -100...). O bot precisa ser ADMIN do canal.
CHANNEL_ID=-1001234567890
# IDs (separados por vírgula) dos administradores que podem usar comandos /listar, /add_dias, /remover
ADMIN_IDS=111111111,222222222

# === Mercado Pago (Pix) ===
# Access Token de PRODUÇÃO ou TESTE gerado em https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
# URL pública (https) que o Mercado Pago vai chamar quando o Pix for pago
# Ex: https://seudominio.com/webhook/mercadopago  (use ngrok/Cloudflare Tunnel em testes)
WEBHOOK_URL=https://seudominio.com/webhook/mercadopago
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# === Regras de assinatura ===
SUBSCRIPTION_PRICE=29.90
SUBSCRIPTION_DAYS=30
WARNING_DAYS_BEFORE=3

# === Agendamento (hora do dia, 0-23, fuso definido em TIMEZONE) ===
CHECK_HOUR=9
DAILY_MESSAGE_HOUR=12
TIMEZONE=America/Sao_Paulo

# === Banco de dados ===
DATABASE_PATH=subscriptions.db
